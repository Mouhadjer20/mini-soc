<group name="account_creation,">
    <rule id="100010" level="3">
        <if_sid>5502,5901,5902,554</if_sid>
        <description>FIM: /etc/passwd or group or shadow modified (Create new user)</description>
        <group>account_creation,</group>
    </rule>

    <rule id="100011" level="12" frequency="5" timeframe="60">
        <if_matched_sid>100010</if_matched_sid>
        <description>Multiple /etc/passwd changes within 60s — bulk account creation on $(hostname)</description>
        <mitre>
            <id>T1136.001</id>
        </mitre>
        <group>persistence,account_creation,</group>
    </rule>
</group>